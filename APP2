    gc()
    message("Session ", session$token, " cleared at ", Sys.time())
  })
  
  output$Age <- renderUI({
    sliderInput(inputId = "Age", label = "Input age in years (>20):", min = 20, max = 100, value = 45)
  }) 
  
  output$Alcohol <- renderUI({
    radioButtons(
      inputId = "Alcohol",
      label = "Input alcohol drinking status:",
      choices = list("No drinking" = 0, "Yes, ever drinking" = 1),
      selected = 1
    )
  })
  
  output$Smoking <- renderUI({
    radioButtons(
      inputId = "Smoking",
      label = "Input smoking status:",
      choices = list(
        "Never smoking more than 100 cigarettes" = 0,
        "Former smoking more than 100 cigarettes" = 1,
        "Current smoking" = 2
      ),
      selected = 1
    )
  })
  
  output$PIR <- renderUI({
    numericInput(inputId = "PIR", label = "Input Poverty Income Ratio:", value = 2.5)
  }) 
  
  output$ALB <- renderUI({
    numericInput(inputId = "ALB", label = "Input serum albumin (g/L):", value = 42.1)
  }) 
  
  output$HR <- renderUI({
    numericInput(inputId = "HR", label = "Input heart rate (BPM):", value = 73)
  }) 
  
  # 核心计算模块：统一获取特征、模型训练与 SHAP 分析
  calc_res <- eventReactive(input$action, {
    req(input$Age, input$PIR, input$Smoking, input$Alcohol, input$ALB, input$HR)
    
    # 1. 读取数据
    df <- read_csv(DP, show_col_types = FALSE)
    df <- as.data.frame(df)
    
    if (!is.factor(df$Depression)) {
      df$Depression <- factor(df$Depression)
    }
    
    # 【关键修复】直接从数据框列名提取自变量特征名，避免访问 xgb_lrn$model$feature_names 得到 NULL
    feature_cols <- setdiff(colnames(df), "Depression")
    
    # 2. 训练模型
    train_task <- as_task_classif(df, target = "Depression")
    xgb_lrn <- lrn(
      "classif.xgboost",
      predict_type = "prob",
      nrounds = 500,
      nthread = 1,
      verbose = 0,
      alpha = 4.455556,
      colsample_bytree = 0.7,
      eta = 0.1,
      max_depth = 2,
      subsample = 0.8
    )
    xgb_lrn$train(train_task)
    
    # 3. 构造输入的预测目标样本 (标准化)
    mytest <- data.frame(
      Age     = (input$Age - mean_values$Age) / sd_values$Age,
      PIR     = (input$PIR - mean_values$PIR) / sd_values$PIR,
      Smoking = as.numeric(input$Smoking),
      Alcohol = as.numeric(input$Alcohol),
      ALB     = (input$ALB - mean_values$ALB) / sd_values$ALB,
      HR      = (input$HR - mean_values$HR) / sd_values$HR
    )
    
    # 确保输入的列顺序与训练特征一致
    mytest <- mytest[, feature_cols, drop = FALSE]
    
    # 4. 计算预测概率
    mytest_task_df <- cbind(mytest, Depression = df$Depression[1])
    mytest_task <- as_task_classif(mytest_task_df, target = "Depression")
    pred <- xgb_lrn$predict(mytest_task)
    
    prob_cols <- colnames(pred$prob)
    target_col <- if ("1" %in% prob_cols) "1" else prob_cols[2]
    ccc <- pred$prob[1, target_col]
    
    # 5. 计算 SHAP 值
    # 【关键修复】动态限制背景数据抽样量，避免数据量小于 100 时报错
    bg_size <- min(50, nrow(df))
    set.seed(123)
    bg_data <- as.matrix(df[sample(nrow(df), bg_size), feature_cols, drop = FALSE])
    test_matrix <- as.matrix(mytest)
    
    # 自定义 kernelshap 的预测适配函数
    pred_fun <- function(m, X) {
      predict(m, newdata = as.matrix(X))
    }
    
    shap_values <- kernelshap(
      xgb_lrn$model,
      X        = test_matrix,
      bg_X     = bg_data,
      pred_fun = pred_fun
    )
    
    list(
      pred_df = data.frame(x = c(ccc, ccc - 0.1, ccc - 0.15)),
      shap    = shapviz(shap_values)
    )
  })
  
  output$predprob <- renderEcharts4r({
    res <- calc_res()
    res$pred_df |> 
      e_charts() |> 
      e_liquid(x) |> 
      e_show_loading()
  })
  
  output$shapfigure <- renderPlot({
    res <- calc_res()
    
    sv_waterfall(res$shap, row_id = 1, max_display = 11) +
      theme_bw() +
      labs(title = "SHAP Values Explanation") +
      theme(
        text        = element_text(size = 8),
        axis.text.x = element_text(size = 6),
        axis.text.y = element_text(size = 6),
        axis.title  = element_text(size = 6),
        plot.title  = element_text(size = 10, face = "bold")
      )
  }, 
  width  = 800,
  height = 400,
  res    = 220
  )
}

shinyApp(ui, server)
